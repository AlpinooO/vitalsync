# Node.js - Dépendances et packages
node_modules/
# Les dépendances npm ne doivent pas être versionnées car elles peuvent être réinstallées via npm ci

# Variables d'environnement - Fichiers sensibles
.env
.env.local
.env.*.local
# Les fichiers .env contiennent des secrets (DB_PASSWORD, tokens) et ne doivent JAMAIS être commités
# Utiliser .env.example comme template

# Logs d'application
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Les fichiers de logs contiennent potentiellement des données sensibles et sont trop volumineux

# Fichiers de build et distribution
dist/
build/
.next/
out/
# Les fichiers compilés/minifiés ne doivent pas être versionnés (régénérés lors du build)

# Coverage de tests
coverage/
.nyc_output/
# Les rapports de couverture de code sont des artefacts de build, pas du code source

# Cache npm/yarn
.npm/
.yarn/cache/
.yarn/install-state.gz
# Les caches locaux de package managers ne doivent pas être versionnés

# Fichiers d'environnement OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~
# Fichiers système créés automatiquement par macOS et Windows

# Éditeurs et IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.project
.classpath
# Les configuration d'IDE sont personnelles et ne doivent pas être commises

# Fichiers temporaires
*.tmp
*.temp
.turbo/
# Fichiers temporaires et caches d'outils

# Base de données locale (si applicable)
*.db
*.sqlite
*.sqlite3
# Les données locales de développement ne doivent pas être commises

